---
import { projects } from '@data/projects';
import PspSlider from './PspSlider.astro';
import ProjectCard from './ProjectCard.astro';
import VisitorClicker from '@components/common/VisitorClicker.astro';
---

<VisitorClicker />

<!-- 2. Section 01: Projects & Test Frameworks -->
<section class="band section" id="projects">
  <div class="wrap">
    <div class="sec-top">
      <div class="sec-title">
        <p class="kicker"><b>01</b><span class="shine" data-i18n="projects.kicker">Featured Projects</span></p>
        <h2 data-i18n-html="projects.title">E2E Architectures &<br />test frameworks.</h2>
      </div>
      <div class="sec-aside">
        <p class="sub" data-i18n="projects.sub">
          Automated test systems engineered for high transaction volumes, cross-platform validation, and continuous delivery gates.
        </p>
      </div>
    </div>

    <div class="cmp-grid">
      {projects.map((project) => (
        project.isSlider ? (
          <PspSlider project={project} />
        ) : (
          <ProjectCard project={project} />
        )
      ))}
    </div>

    <p class="note-row" data-i18n="projects.note">
      All projects feature Page Object Model (POM) architecture, isolated fixtures, and full observability with video captures and structured logs.
    </p>
  </div>
</section>
