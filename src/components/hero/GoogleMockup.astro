---
---

<!-- Right View (Underneath / Beyond --p): Dynamic Google Search Scenario Visualizers -->
<div class="demo-view demo-view-before" id="google-view">
  
  <!-- 1. WEBSITE E2E: Google.com Live Home View -->
  <div class="google-browser-frame g-scenario-view active" data-view="e2e">
    <!-- Browser Omnibox Top Bar -->
    <div class="browser-chrome-bar">
      <div class="browser-window-dots">
        <span class="b-dot b-red"></span>
        <span class="b-dot b-yellow"></span>
        <span class="b-dot b-green"></span>
      </div>
      <div class="browser-address-field">
        <svg class="b-lock-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <span class="b-url-text">https://www.google.com</span>
        <span class="b-status-pill">200 OK</span>
      </div>
      <div class="browser-meta-tag">CHROMIUM</div>
    </div>

    <!-- Google Page Top Navigation -->
    <div class="google-page-header">
      <span class="g-link">Gmail</span>
      <span class="g-link">Imágenes</span>
      <div class="g-apps-grid" aria-label="Google Apps">
        <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
      </div>
      <div class="g-profile-avatar" title="QA SDET Profile">JC</div>
    </div>

    <!-- Google Center Body -->
    <div class="google-center-stage">
      <div class="google-wordmark" aria-label="Google">
        <span class="g-blue">G</span><span class="g-red">o</span><span class="g-yellow">o</span><span class="g-blue">g</span><span class="g-green">l</span><span class="g-red">e</span>
      </div>

      <div class="google-search-box-wrap">
        <div class="google-search-input-box">
          <svg class="g-search-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <input type="text" class="google-input-field" value="playwright test automation engineer" readonly />
          <div class="google-input-icons">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
              <line x1="12" x2="12" y1="19" y2="22"></line>
            </svg>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
              <circle cx="12" cy="13" r="4"></circle>
            </svg>
          </div>
        </div>
      </div>

      <div class="google-action-buttons">
        <button class="g-action-btn" type="button" data-i18n="studio.googleSearchBtn">Google Search</button>
        <button class="g-action-btn" type="button" data-i18n="studio.luckyBtn">I'm Feeling Lucky</button>
      </div>

      <div class="google-lang-row">
        <span data-i18n="studio.offeredIn">Google offered in:</span>
        <a href="#top">Español</a>
        <a href="#top">Català</a>
        <a href="#top">Galego</a>
        <a href="#top">Euskara</a>
      </div>
    </div>

    <div class="google-footer-bar">
      <span data-i18n="studio.footerLocation">Spain · From your IP address</span>
      <span data-i18n="studio.footerSettings">Dark theme · Privacy</span>
    </div>
  </div>

  <!-- 2. API TESTING: Autocomplete Suggest API + JSON Inspector -->
  <div class="google-browser-frame g-scenario-view" data-view="api">
    <div class="browser-chrome-bar">
      <div class="browser-window-dots">
        <span class="b-dot b-red"></span>
        <span class="b-dot b-yellow"></span>
        <span class="b-dot b-green"></span>
      </div>
      <div class="browser-address-field">
        <svg class="b-lock-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <span class="b-url-text">https://www.google.com/complete/search?q=how+to+hire</span>
        <span class="b-status-pill">200 OK</span>
      </div>
      <div class="browser-meta-tag">REST / JSON</div>
    </div>

    <div class="g-api-stage">
      <div class="g-api-header">
        <div class="g-api-logo-wrap">
          <span class="g-wordmark-mini" aria-label="Google"><span class="g-blue">G</span><span class="g-red">o</span><span class="g-yellow">o</span><span class="g-blue">g</span><span class="g-green">l</span><span class="g-red">e</span></span>
          <span class="g-subtag">Autocomplete Suggest API</span>
        </div>
        <div class="google-search-input-box g-search-input-box g-input-active">
          <svg class="g-search-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <span class="g-typed-text">how to hire <span class="g-cursor">|</span></span>
          <span class="b-status-pill" style="margin-left:auto;">GET · 14ms</span>
        </div>
        <div class="g-suggest-panel">
          <div class="g-suggest-item active">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
            <span><strong>how to hire</strong> Juan Carlos Gutierrez</span>
            <span class="g-suggest-tag">item[0]</span>
          </div>
          <div class="g-suggest-item">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
            <span><strong>how to hire</strong> Juan Carlos Gutierrez for auto testing</span>
            <span class="g-suggest-tag">item[1]</span>
          </div>
          <div class="g-suggest-item">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
            <span><strong>how to hire</strong> Juan Carlos Gutierrez SDET Madrid</span>
            <span class="g-suggest-tag">item[2]</span>
          </div>
          <div class="g-suggest-item">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
            <span><strong>how to hire</strong> Juan Carlos Gutierrez Playwright Expert</span>
            <span class="g-suggest-tag">item[3]</span>
          </div>
        </div>
      </div>

      <!-- Live JSON Contract Response -->
      <div class="g-json-inspector">
        <div class="g-json-header">
          <span class="g-json-badge">HTTP 200 OK</span>
          <span class="g-json-badge g-badge-teal">Schema: Draft 2020-12 (Valid)</span>
          <span class="g-json-badge g-badge-dim">Payload: 4 items</span>
        </div>
        <pre class="g-json-code"><code>{`{
  "query": "how to hire",
  "endpoint": "/complete/search?client=chrome&q=how+to+hire",
  "suggestions": [
    "Juan Carlos Gutierrez",
    "Juan Carlos Gutierrez for auto testing",
    "Juan Carlos Gutierrez SDET Madrid",
    "Juan Carlos Gutierrez Playwright Expert"
  ],
  "headers": {
    "content-type": "application/json; charset=UTF-8",
    "cache-control": "private, max-age=3600"
  },
  "candidate_match": "QA Automation Engineer / SDET",
  "contract_check": true
}`}</code></pre>
      </div>
    </div>

    <div class="google-footer-bar">
      <span>Endpoint: api.google.com/complete/search</span>
      <span>SLA: p99 &lt; 45ms Verified</span>
    </div>
  </div>

  <!-- 3. ACCESSIBILITY: WCAG 2.2 AAA Audit on Google Search -->
  <div class="google-browser-frame g-scenario-view" data-view="a11y">
    <div class="browser-chrome-bar">
      <div class="browser-window-dots">
        <span class="b-dot b-red"></span>
        <span class="b-dot b-yellow"></span>
        <span class="b-dot b-green"></span>
      </div>
      <div class="browser-address-field">
        <svg class="b-lock-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <span class="b-url-text">https://www.google.com/#a11y-audit</span>
        <span class="b-status-pill">WCAG 2.2 AAA</span>
      </div>
      <div class="browser-meta-tag">AXE-CORE</div>
    </div>

    <div class="g-a11y-stage">
      <div class="google-center-stage" style="padding: 12px 0;">
        <span class="a11y-pill-tag">img alt="Google" · Pass (AAA)</span>
        <div class="google-wordmark" aria-label="Google" style="margin-bottom: 12px;">
          <span class="g-blue">G</span><span class="g-red">o</span><span class="g-yellow">o</span><span class="g-blue">g</span><span class="g-green">l</span><span class="g-red">e</span>
        </div>

        <div class="google-search-box-wrap" style="margin-bottom: 12px;">
          <span class="a11y-pill-tag">role="combobox" · aria-label="Buscar" · Contrast: 14.2:1 (AAA)</span>
          <div class="google-search-input-box a11y-focus-ring">
            <svg class="g-search-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
            <input type="text" class="google-input-field" value="playwright test automation engineer" readonly />
          </div>
        </div>

        <div class="google-action-buttons" style="margin-bottom: 10px;">
          <span class="a11y-pill-tag">role="button" · Contrast: 8.5:1</span>
        </div>

        <div class="google-lang-row">
          <span class="a11y-pill-tag">nav landmarks: 4 elements · Tab Order [1→2→3]</span>
        </div>
      </div>

      <div class="a11y-bottom-bar">
        <span>✔ 0 Violations (axe-core v4.10)</span>
        <span>✔ 100% Screen Reader Certified</span>
      </div>
    </div>
  </div>

  <!-- 4. CI/CD: Automated Multi-Browser Pipeline for Google.com -->
  <div class="google-browser-frame g-scenario-view" data-view="cicd">
    <div class="browser-chrome-bar">
      <div class="browser-window-dots">
        <span class="b-dot b-red"></span>
        <span class="b-dot b-yellow"></span>
        <span class="b-dot b-green"></span>
      </div>
      <div class="browser-address-field">
        <svg class="b-lock-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <span class="b-url-text">https://github.com/juancarlos/google-e2e/actions/1420</span>
        <span class="b-status-pill">GREEN GATE</span>
      </div>
      <div class="browser-meta-tag">GITHUB ACTIONS</div>
    </div>

    <div class="g-cicd-stage">
      <div class="g-cicd-top">
        <span><strong>Workflow:</strong> google-e2e-matrix.yml</span>
        <span><strong>Trigger:</strong> main push #1420</span>
      </div>

      <div class="g-cicd-grid">
        <div class="g-worker-card">
          <div class="g-worker-title">
            <span style="color:#22c55e;">✔</span> Chromium Desktop
          </div>
          <div class="g-worker-meta">1920x1080 · 6/6 passed (18s)</div>
        </div>
        <div class="g-worker-card">
          <div class="g-worker-title">
            <span style="color:#22c55e;">✔</span> Firefox Headless
          </div>
          <div class="g-worker-meta">Ubuntu 22.04 · 6/6 passed (22s)</div>
        </div>
        <div class="g-worker-card">
          <div class="g-worker-title">
            <span style="color:#22c55e;">✔</span> WebKit (Safari Engine)
          </div>
          <div class="g-worker-meta">macOS-14 · 6/6 passed (26s)</div>
        </div>
        <div class="g-worker-card">
          <div class="g-worker-title">
            <span style="color:#22c55e;">✔</span> Mobile Emulation
          </div>
          <div class="g-worker-meta">Pixel 7 · 6/6 passed (15s)</div>
        </div>
      </div>

      <div class="g-cicd-artifacts">
        <span>📦 playwright-report.html (8.4MB)</span>
        <span>🎬 google-search-trace.zip</span>
      </div>
    </div>

    <div class="google-footer-bar">
      <span>Deploy Gate: Passed</span>
      <span>Push to Production: Approved ✔</span>
    </div>
  </div>

  <!-- 5. PERFORMANCE: Google Search Core Web Vitals & Lighthouse -->
  <div class="google-browser-frame g-scenario-view" data-view="perf">
    <div class="browser-chrome-bar">
      <div class="browser-window-dots">
        <span class="b-dot b-red"></span>
        <span class="b-dot b-yellow"></span>
        <span class="b-dot b-green"></span>
      </div>
      <div class="browser-address-field">
        <svg class="b-lock-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <span class="b-url-text">https://www.google.com/#lighthouse-audit</span>
        <span class="b-status-pill">SCORE 100/100</span>
      </div>
      <div class="browser-meta-tag">LIGHTHOUSE v12</div>
    </div>

    <div class="g-perf-stage">
      <div class="g-scores-row">
        <div class="g-score-dial">
          <div class="g-score-circle">100</div>
          <span class="g-score-label">Performance</span>
        </div>
        <div class="g-score-dial">
          <div class="g-score-circle">100</div>
          <span class="g-score-label">Accessibility</span>
        </div>
        <div class="g-score-dial">
          <div class="g-score-circle">100</div>
          <span class="g-score-label">Best Practices</span>
        </div>
        <div class="g-score-dial">
          <div class="g-score-circle">100</div>
          <span class="g-score-label">SEO</span>
        </div>
      </div>

      <div class="g-vitals-grid">
        <div class="g-vital-card">
          <span class="g-vital-name">Largest Contentful Paint</span>
          <span class="g-vital-val">0.65s</span>
          <span class="g-vital-rating">Good (&lt; 2.5s)</span>
        </div>
        <div class="g-vital-card">
          <span class="g-vital-name">Interaction to Next Paint</span>
          <span class="g-vital-val">24ms</span>
          <span class="g-vital-rating">Good (&lt; 200ms)</span>
        </div>
        <div class="g-vital-card">
          <span class="g-vital-name">Cumulative Layout Shift</span>
          <span class="g-vital-val">0.00</span>
          <span class="g-vital-rating">Zero layout shift</span>
        </div>
        <div class="g-vital-card">
          <span class="g-vital-name">Time to First Byte (TTFB)</span>
          <span class="g-vital-val">42ms</span>
          <span class="g-vital-rating">Fast (&lt; 800ms)</span>
        </div>
      </div>
    </div>

    <div class="google-footer-bar">
      <span>Audit Target: google.com (Landing)</span>
      <span>Render Blocking: 0 resources</span>
    </div>
  </div>

</div>
