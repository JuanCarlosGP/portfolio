<div class="hero-left">
  <div class="hero-tag">
    <p class="eyebrow">
      <span class="shine">Madrid, España · Portfolio Personal</span>
    </p>
  </div>

  <div class="hero-main">
    <!-- Personal Profile Header & Large GitHub Avatar -->
    <div class="hero-profile-header">
      <div class="hero-avatar-ring">
        <img src="/avatar.png" alt="Juan Carlos Gutiérrez Pesquero" class="hero-avatar-img" width="164" height="164" loading="eager" />
      </div>
      <div class="hero-profile-meta">
        <span class="hero-profile-badge">
          <i class="dot emerald" aria-hidden="true"></i>
          <span>DISPONIBLE / OPEN TO WORK</span>
        </span>
        <h2 class="hero-profile-name">Juan Carlos Gutiérrez</h2>
