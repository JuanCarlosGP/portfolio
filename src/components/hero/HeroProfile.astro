---
---

<div class="hero-left">
  <div class="hero-tag">
    <p class="eyebrow">
      <span class="shine" data-i18n="hero.eyebrow">Madrid, Spain · Personal Portfolio</span>
    </p>
  </div>

  <div class="hero-main">
    <!-- Personal Profile Header & Large GitHub Avatar -->
    <div class="hero-profile-header">
      <div class="hero-avatar-ring">
        <img src={`${import.meta.env.BASE_URL}avatar.png`} alt="Juan Carlos Gutiérrez Pesquero" class="hero-avatar-img" width="164" height="164" loading="eager" />
      </div>
      <div class="hero-profile-meta">
        <h2 class="hero-profile-name">Juan Carlos Gutiérrez</h2>
        <span class="hero-profile-badge">
          <i class="dot emerald" aria-hidden="true"></i>
          <span data-i18n="hero.badge">AVAILABLE / OPEN TO WORK</span>
        </span>
      </div>
    </div>

    <h1>
      <span class="h1-static" data-i18n="hero.h1Static">Engineering for</span>
      <span class="h1-typed"><span id="typed">robust test suites.</span><span class="caret" id="caret"></span></span>
    </h1>

    <p class="lede" data-i18n-html="hero.lede">
      Hi! I'm <strong>Juan Carlos</strong>. I design and build <strong>automated testing architectures</strong> in any environment that eliminate flakiness and accelerate production deployments. My focus is on CI/CD pipeline reliability, <strong>deterministic testing</strong>, and building tools that solve real software quality challenges.
    </p>

    <div class="hero-cta">
      <a class="btn primary lg" href="https://www.linkedin.com/in/juancarlosgutierrezpesquero/" target="_blank" rel="noopener" aria-label="Connect with Juan Carlos on LinkedIn" data-i18n-attr="aria-label:hero.ctaAria">
        <svg class="icon-linkedin" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037c-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85c3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.06 2.06 0 0 1-2.063-2.065a2.064 2.064 0 1 1 2.063 2.065m1.782 13.019H3.555V9h3.564zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z"/>
        </svg>
        <span data-i18n="hero.cta">Let's connect?</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17 17 7M8 7h9v9" />
        </svg>
      </a>
    </div>
  </div>

  <ul class="facts">
    <li data-i18n="hero.facts.0">Deterministic Testing</li>
    <li data-i18n="hero.facts.1">Playwright &amp; Maestro</li>
    <li data-i18n="hero.facts.2">Madrid · Fuenlabrada</li>
  </ul>
</div>
