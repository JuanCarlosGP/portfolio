---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Juan Carlos Gutiérrez Pesquero — QA Automation Engineer & SDET",
  description = "QA Automation Engineer / SDET specializing in Playwright, Maestro, TypeScript, zero-flakiness test architectures, and high-velocity CI/CD pipelines.",
  image = `${import.meta.env.BASE_URL}og-image.png`
} = Astro.props;

const siteURL = Astro.site || 'https://juancarlosgp.github.io';
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const socialImageURL = new URL(image, siteURL);
---

<script is:inline>
  try {
    if (localStorage.getItem('portfolio-font') === 'pixel') {
      document.documentElement.setAttribute('data-font', 'pixel');
    }
    var savedLang = localStorage.getItem('portfolio-lang') || 'en';
    document.documentElement.setAttribute('data-lang', savedLang);
    document.documentElement.lang = savedLang;
    document.documentElement.setAttribute('translate', 'no');
    document.documentElement.classList.add('notranslate');
  } catch (e) {}
</script>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="google" content="notranslate" />
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%23d0bcf7'/><text y='70' x='18' font-size='60' font-family='monospace' font-weight='bold' fill='%2307070a'>JC</text></svg>" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#07070a" />
<meta name="author" content="Juan Carlos Gutiérrez Pesquero" />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content="Juan Carlos Gutiérrez | QA & SDET Portfolio" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Juan Carlos Gutiérrez — QA Automation Engineer & SDET Portfolio preview" />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL} />
<meta name="twitter:image:alt" content="Juan Carlos Gutiérrez — QA Automation Engineer & SDET Portfolio preview" />

<!-- Google Fonts: Preconnect & Direct Stylesheet (eliminates render-blocking @import waterfall) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@300;400;500;600;700&family=Inter:wght@400;500;600&display=swap" />

<!-- Structured Data (JSON-LD) for Search Engines & Technical Rich Snippets -->
<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "name": "Juan Carlos Gutiérrez Pesquero",
    "alternateName": "Juan Carlos Gutiérrez",
    "jobTitle": "QA Automation Engineer & SDET",
    "description": description,
    "url": siteURL,
    "image": socialImageURL.toString(),
    "sameAs": [
      "https://www.linkedin.com/in/juancarlosgutierrezpesquero/",
      "https://github.com/JuanCarlosGP"
    ],
    "knowsAbout": [
      "Playwright",
      "Maestro",
      "TypeScript",
      "Software Development Engineer in Test (SDET)",
      "CI/CD Pipelines",
      "API Testing",
      "Hardware Diagnostics",
      "Automated Testing Architectures"
    ]
  }
})} />
