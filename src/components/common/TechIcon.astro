---
interface Props {
  name: string;
}

const { name } = Astro.props;

const skillSlug: Record<string, string> = {
  Playwright: "playwright",
  "Maestro (Mobile)": "maestro",
  WebdriverIO: "maestro",
  "Jest / Vitest": "vitest",
  "K6 / Load Testing": "k6",
  "Postman / Newman": "postman",
  "Axe-core (A11y)": "axe",
  "Pixelmatch (Visual)": "axe",
  TypeScript: "typescript",
  "JavaScript (Node.js)": "node",
  "JavaScript (ESM)": "node",
  Python: "python",
  "Bash / Shell": "bash",
  "Java (Core / JVM)": "java",
  "Java (Paper / Core)": "java",
  "SQL / SQLite": "sqlite",
  "GitHub Actions": "github",
  "Azure DevOps": "azure",
  "NSSM Windows Svc": "azure",
  "Docker & Containers": "docker",
  "Cloudflare Workers": "cloudflare",
  "Linux / POSIX Env": "linux",
  "Arch / Debian Linux": "linux",
  "Git Workflows": "git",
  "Git Worktrees & CI": "git",
  "Page Object Model": "pom",
  "Contract Testing": "pact",
  "Ajv / JSON Schema": "json",
  "BDD / Cucumber": "cucumber",
  "Allure Reporting": "allure",
  "Trace & Video Capture": "allure",
  "Network Mocking": "network",
};
---

<span class="skill-icon" data-skill={skillSlug[name] ?? "generic"} aria-hidden="true">
  {name === 'Playwright' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect width="20" height="15" x="2" y="3" rx="2" />
      <line x1="2" x2="22" y1="8" y2="8" />
      <path d="m9 13 2 2 4-4" />
      <path d="M6 19v2" />
      <path d="M18 19v2" />
    </svg>
  )}
  {(name === 'Maestro (Mobile)' || name === 'WebdriverIO') && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect width="14" height="20" x="5" y="2" rx="2.5" />
      <path d="M12 18h.01" />
      <path d="m13 6-3 4.5h3.5L10.5 15" />
    </svg>
  )}
  {name === 'Jest / Vitest' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" />
    </svg>
  )}
  {name === 'K6 / Load Testing' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m12 14 4-4" />
      <path d="M3.34 19a10 10 0 1 1 17.32 0" />
      <circle cx="12" cy="14" r="1.5" />
    </svg>
  )}
  {name === 'Postman / Newman' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z" />
      <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z" />
      <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0" />
      <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" />
    </svg>
  )}
  {(name === 'Axe-core (A11y)' || name === 'Pixelmatch (Visual)') && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="4.5" r="2" />
      <path d="m4.5 9 7.5 1.5 7.5-1.5" />
      <path d="m9 21.5 3-8 3 8" />
      <path d="M12 11v4" />
    </svg>
  )}
  {name === 'TypeScript' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect width="18" height="18" x="3" y="3" rx="3" />
      <path d="M7 10h6M10 10v7" />
      <path d="M14 17c.5.5 1 .8 1.8.8 1 0 1.7-.5 1.7-1.3 0-1.8-3.2-.8-3.2-2.7 0-.9.7-1.6 1.7-1.6.7 0 1.3.3 1.7.7" />
    </svg>
  )}
  {(name === 'JavaScript (Node.js)' || name === 'JavaScript (ESM)') && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polygon points="12 2 21 7.5 21 16.5 12 22 3 16.5 3 7.5" />
      <line x1="12" x2="12" y1="12" y2="22" />
      <line x1="12" x2="21" y1="12" y2="7.5" />
      <line x1="12" x2="3" y1="12" y2="7.5" />
    </svg>
  )}
  {name === 'Python' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path class="py-top" d="M12 2c-3 0-5 1.5-5 3.5V8h5v1H5.5C3.5 9 2 10.8 2 13s1.5 4 3.5 4H7v-2.5c0-1.8 1.5-3.5 3.5-3.5h5V9h-3.5V5.5C12 3.5 14 2 12 2z" />
      <path class="py-bot" d="M12 22c3 0 5-1.5 5-3.5V16h-5v-1h6.5c2 0 3.5-1.8 3.5-4s-1.5-4-3.5-4H17v2.5c0 1.8-1.5 3.5-3.5 3.5h-5V15h3.5v3.5c0 2-2 3.5 0 3.5z" />
      <circle class="py-top" cx="9" cy="5" r=".8" fill="currentColor" />
      <circle class="py-bot" cx="15" cy="19" r=".8" fill="currentColor" />
    </svg>
  )}
  {name === 'Bash / Shell' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="4 17 10 11 4 5" />
      <line x1="12" x2="20" y1="19" y2="19" />
    </svg>
  )}
  {(name === 'Java (Core / JVM)' || name === 'Java (Paper / Core)') && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
      <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
      <line x1="6" x2="6" y1="2" y2="4" />
      <line x1="10" x2="10" y1="2" y2="4" />
      <line x1="14" x2="14" y1="2" y2="4" />
    </svg>
  )}
  {name === 'SQL / SQLite' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <ellipse cx="12" cy="5" rx="9" ry="3" />
      <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
      <path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3" />
    </svg>
  )}
  {name === 'GitHub Actions' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="6" cy="6" r="3" />
      <circle cx="6" cy="18" r="3" />
      <line x1="6" x2="6" y1="9" y2="15" />
      <circle cx="18" cy="9" r="3" />
      <path d="M6 9a9 9 0 0 0 9-3" />
      <polyline points="15 6 18 9 15 12" />
    </svg>
  )}
  {(name === 'Azure DevOps' || name === 'NSSM Windows Svc') && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" />
      <polyline points="13 13 15 15 13 17" />
      <line x1="9" x2="15" y1="15" y2="15" />
    </svg>
  )}
  {name === 'Docker & Containers' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="7" width="20" height="14" rx="2" />
      <path d="M2 12h20" />
      <path d="M7 12v9" />
      <path d="M12 12v9" />
      <path d="M17 12v9" />
      <path d="M7 7V4a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v3" />
    </svg>
  )}
  {name === 'Cloudflare Workers' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
      <path d="m11 13 3-4h-2.5l1.5-3" />
    </svg>
  )}
  {(name === 'Linux / POSIX Env' || name === 'Arch / Debian Linux') && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect width="18" height="18" x="3" y="3" rx="3" />
      <path d="m8 9 3 3-3 3" />
      <line x1="13" x2="16" y1="15" y2="15" />
    </svg>
  )}
  {(name === 'Git Workflows' || name === 'Git Worktrees & CI') && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="6" x2="6" y1="3" y2="15" />
      <circle cx="18" cy="6" r="3" />
      <circle cx="6" cy="18" r="3" />
      <path d="M18 9a9 9 0 0 1-9 9" />
    </svg>
  )}
  {name === 'Page Object Model' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z" />
      <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65" />
      <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65" />
    </svg>
  )}
  {name === 'Contract Testing' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
      <path d="m9 12 2 2 4-4" />
    </svg>
  )}
  {name === 'Ajv / JSON Schema' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5a2 2 0 0 0 2 2h1" />
      <path d="M16 3h1a2 2 0 0 1 2 2v5a2 2 0 0 0 2 2 2 2 0 0 0-2 2v5a2 2 0 0 1-2 2h-1" />
    </svg>
  )}
  {name === 'BDD / Cucumber' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 11l3 3L22 4" />
      <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
    </svg>
  )}
  {(name === 'Allure Reporting' || name === 'Trace & Video Capture') && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 3v18h18" />
      <path d="M7 16v-4" />
      <path d="M11 16V8" />
      <path d="M15 16v-6" />
      <path d="m18 7-3 3-4-4-4 4" />
    </svg>
  )}
  {name === 'Network Mocking' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4.93 19.07A10 10 0 0 1 19.07 4.93" />
      <path d="M7.76 16.24a6 6 0 0 1 8.48-8.48" />
      <circle cx="12" cy="12" r="2" />
      <line x1="2" x2="6" y1="2" y2="6" />
      <line x1="18" x2="22" y1="18" y2="22" />
    </svg>
  )}
</span>
