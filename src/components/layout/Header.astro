---
---

<header class="nav">
  <div class="wrap nav-in">
    <a class="brand nav-brand" href="#top" aria-label="Juan Carlos Gutiérrez Pesquero - Portfolio" data-i18n-attr="aria-label:nav.brandAria">
      <span class="brand-icon">JC</span>
      <span class="brand-sep">/</span>
      <span class="brand-tool">QA</span>
      <span class="tag status-tag">● SDET</span>
    </a>

    <nav class="nav-links" aria-label="Secciones del sitio">
      <a href="#projects" data-i18n="nav.projects">Projects</a>
      <a href="#experience" data-i18n="nav.experience">Experience</a>
      <a href="#gallery" data-i18n="nav.gallery">Gallery</a>
      <a href="#stack" data-i18n="nav.stack">Stack</a>
      <a href="#contact" data-i18n="nav.contact">Contact</a>
    </nav>

    <div class="nav-cta">
      <button class="btn lang-toggle-btn" id="lang-toggle-btn" title="Switch language (EN / ES)" aria-label="Toggle language between English and Spanish">
        <svg class="icon-lang" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span class="lang-switch-text">
          <span class="lang-opt active" data-lang-opt="en">EN</span>
          <span class="lang-sep">/</span>
          <span class="lang-opt" data-lang-opt="es">ES</span>
        </span>
      </button>

      <button class="btn" id="font-toggle-btn" title="Toggle typography between Geist and Geist Pixel" aria-label="Change site typography" data-i18n-attr="title:nav.fontToggleTitle,aria-label:nav.fontToggleAria">
        <svg class="icon-calligraphy" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m12 19 7-7 3 3-7 7-3-3z"></path>
          <path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
          <path d="m2 2 7.586 7.586"></path>
          <circle cx="11" cy="11" r="2"></circle>
        </svg>
        <span id="font-toggle-label">Pixel</span>
      </button>

      <button class="btn" id="replay-swarm-btn" title="Rebuild live site with AI agents and sound" data-i18n-attr="title:nav.agentModeTitle">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="5" y="2" width="14" height="20" rx="7"></rect>
          <path d="M12 6v4"></path>
        </svg>
        <span data-i18n="nav.agentMode">Agents</span>
      </button>

      <a class="btn primary" href="https://github.com/JuanCarlosGP" target="_blank" rel="noopener">
        <span>GitHub ↗</span>
      </a>
    </div>
  </div>
</header>
