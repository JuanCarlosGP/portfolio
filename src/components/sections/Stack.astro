---
import { stackCategories } from '@data/stack';
import TechIcon from '@components/common/TechIcon.astro';
---

<div class="band gap" aria-hidden="true"><div class="wrap"></div></div>

<!-- 5. Section 04: Skills & Tech Matrix -->
<section class="band section" id="stack">
  <div class="wrap">
    <div class="sec-top">
      <div class="sec-title">
        <p class="kicker"><b>04</b><span class="shine" data-i18n="stack.kicker">Tools & Technologies</span></p>
        <h2 data-i18n-html="stack.title">Technical Stack &<br />specialization.</h2>
      </div>
      <div class="sec-aside">
        <p class="sub" data-i18n="stack.sub">
          Mastered suite of technologies and languages to engineer modern, maintainable, high-performance testing infrastructures.
        </p>
      </div>
    </div>

    <div class="skills-grid">
      {stackCategories.map((category, idx) => {
        const catKeys = ['testing', 'languages', 'cicd', 'architecture'] as const;
        const catKey = catKeys[idx];
        return (
          <div class="skill-col">
            <h4 data-i18n={`stack.categories.${catKey}`}>{category.title}</h4>
          <div class="skill-list">
            {category.skills.map((skill) => (
              <div class="skill-item">
                <TechIcon name={skill.name} />
                <span class="skill-name">{skill.name}</span>
              </div>
            ))}
          </div>
        </div>
      );})}
    </div>
  </div>
</section>
