---
import { stackCategories } from '@data/stack';
---

<div class="band gap" aria-hidden="true"><div class="wrap"></div></div>

<!-- 5. Section 04: Skills & Tech Matrix -->
<section class="band section" id="stack">
  <div class="wrap">
    <div class="sec-top">
      <div class="sec-title">
        <p class="kicker"><b>04</b><span class="shine">Herramientas y tecnologías</span></p>
        <h2>Stack técnico<br />y especialización.</h2>
      </div>
      <div class="sec-aside">
        <p class="sub">
          Conjunto de tecnologías y lenguajes dominados para construir infraestructuras de testing modernas, mantenibles y de alto rendimiento.
        </p>
      </div>
    </div>

    <div class="skills-grid">
      {stackCategories.map((category) => (
        <div class="skill-col">
          <h4>{category.title}</h4>
          <div class="skill-list">
            {category.skills.map((skill) => (
              <div class="skill-item">
                <span>{skill.name}</span>
                <span class="skill-lvl">{skill.detail}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
