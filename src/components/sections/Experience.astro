---
import { experience, secondaryExperience, proHighlights } from '@data/experience';

const izertis = experience.find((e) => e.id === 'izertis') || experience[0];
const iteggo = experience.find((e) => e.id === 'iteggo') || experience[1];
const gorilast = secondaryExperience.find((e) => e.id === 'gorilast') || secondaryExperience[0];
const accenture = secondaryExperience.find((e) => e.id === 'accenture') || secondaryExperience[1];
---

<div class="band gap" aria-hidden="true"><div class="wrap"></div></div>

<!-- Section 02: Career & Experience -->
<section class="band section" id="experience">
  <div class="wrap">
    <div class="sec-top">
      <div class="sec-title">
        <p class="kicker"><b>02</b><span class="shine" data-i18n="experience.kicker">Professional Experience</span></p>
        <h2 data-i18n-html="experience.title">Proven track record in<br />software quality.</h2>
      </div>
      <div class="sec-aside">
        <p class="sub" data-i18n="experience.sub">
          Delivering technical rigor, scalable automation frameworks, and enterprise testing standards across banking, retail, and aviation sectors.
        </p>
      </div>
    </div>

    <!-- Primary Enterprise Trajectory Grid (Izertis & itegGO) -->
    <div class="pair exp-primary-pair">
      <!-- Card 1: IZERTIS, S.A. (Consultoría Tecnológica / Laboral Kutxa) -->
      <div class="pair-card exp-card exp-card-izertis">
        <div class="exp-card-header">
          <div class="exp-badge-row">
            <span class="exp-status-badge live">● <span data-i18n="experience.izertisBadge">{izertis.badge}</span></span>
          </div>
          <p class="exp-client-tag" data-i18n="experience.izertisClient">{izertis.client}</p>
          <p class="mono-cap" style="color: var(--accent2);" data-i18n="experience.izertisRole">{izertis.role}</p>
          <h3>{izertis.company}</h3>
          <p class="exp-period" data-i18n="experience.izertisPeriod">{izertis.period}</p>
        </div>

        <ul class="ticks">
          {izertis.bullets.map((bullet, idx) => (
            <li data-i18n-html={`experience.izertisBullets.${idx}`} set:html={bullet} />
          ))}
        </ul>

        {izertis.skills && (
          <div class="exp-skills-row" aria-label="Tecnologías principales">
            {izertis.skills.map((skill) => (
              <span class="exp-skill-chip">{skill}</span>
            ))}
          </div>
        )}
      </div>

      <!-- Card 2: itegGO CONSULTING (Consultoría Tecnológica / Retail Dia & Aviación Iberia) -->
      <div class="pair-card exp-card exp-card-iteggo">
        <div class="exp-card-header">
          <div class="exp-badge-row">
            <span class="exp-status-badge">● <span data-i18n="experience.iteggoBadge">{iteggo.badge}</span></span>
          </div>
          <p class="exp-client-tag" data-i18n="experience.iteggoClient">{iteggo.client}</p>
          <p class="mono-cap" style="color: var(--accent2);" data-i18n="experience.iteggoRole">{iteggo.role}</p>
          <h3>{iteggo.company}</h3>
          <p class="exp-period" data-i18n="experience.iteggoPeriod">{iteggo.period}</p>
        </div>

        <ul class="ticks">
          {iteggo.bullets.map((bullet, idx) => (
            <li data-i18n-html={`experience.iteggoBullets.${idx}`} set:html={bullet} />
          ))}
        </ul>

        {iteggo.skills && (
          <div class="exp-skills-row" aria-label="Tecnologías principales">
            {iteggo.skills.map((skill) => (
              <span class="exp-skill-chip">{skill}</span>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Secondary Trajectory & Performance Metrics Grid -->
    <div class="exp-secondary-band">
      <div class="exp-secondary-header">
        <p class="kicker"><b>02.1</b><span class="shine" data-i18n="experience.secondaryKicker">Complementary Background & Prior Roles</span></p>
        <h4 data-i18n="experience.secondaryTitle">Previous engineering & security experience.</h4>
      </div>

      <div class="exp-secondary-grid">
        <!-- Column 1: Compact Secondary Roles (Gorilast & Accenture) -->
        <div class="exp-secondary-roles-col">
          <!-- Gorilast Compact Card -->
          <article class="exp-compact-card">
            <div class="exp-compact-top">
              <span class="exp-compact-badge" data-i18n="experience.gorilastBadge">{gorilast.badge}</span>
              <span class="exp-compact-period" data-i18n="experience.gorilastPeriod">{gorilast.period}</span>
            </div>
            <div class="exp-compact-body">
              <h4 class="exp-compact-company">{gorilast.company}</h4>
              <p class="exp-compact-role" data-i18n="experience.gorilastRole">{gorilast.role}</p>
              <p class="exp-compact-desc" data-i18n="experience.gorilastDesc">{gorilast.detail}</p>
            </div>
            <div class="exp-skills-row">
              {gorilast.skills.map((skill) => (
                <span class="exp-skill-chip">{skill}</span>
              ))}
            </div>
          </article>

          <!-- Accenture Spain Compact Card -->
          <article class="exp-compact-card">
            <div class="exp-compact-top">
              <span class="exp-compact-badge" data-i18n="experience.accentureBadge">{accenture.badge}</span>
              <span class="exp-compact-period" data-i18n="experience.accenturePeriod">{accenture.period}</span>
            </div>
            <div class="exp-compact-body">
              <h4 class="exp-compact-company">{accenture.company}</h4>
              <p class="exp-compact-role" data-i18n="experience.accentureRole">{accenture.role}</p>
              <p class="exp-compact-desc" data-i18n="experience.accentureDesc">{accenture.detail}</p>
            </div>
            <div class="exp-skills-row">
              {accenture.skills.map((skill) => (
                <span class="exp-skill-chip">{skill}</span>
              ))}
            </div>
          </article>
        </div>

        <!-- Column 2: Devault Pro-Card (Agentic QA Architecture & Human-in-the-Loop) -->
        <div class="pro-card exp-pro-card">
          <div class="pro-in">
            <span class="pro-badge">
              <i aria-hidden="true"></i>
              <span class="shine" data-i18n="experience.proBadge">AI-ASSISTED QA ARCHITECTURE</span>
            </span>

            <h3 data-i18n-html="experience.proHeading">Agentic Testing &amp; <em>Human-in-the-Loop</em></h3>

            <div class="pro-stats">
              <div>
                <dt data-i18n="experience.statStep1">01 · SCOUT</dt>
                <dd data-i18n="experience.statStep1Desc">Flow & Ticket Map</dd>
              </div>
              <div>
                <dt data-i18n="experience.statStep2">02 · AUTHOR</dt>
                <dd data-i18n="experience.statStep2Desc">Gherkin & Modular POM</dd>
              </div>
              <div>
                <dt data-i18n="experience.statStep3">03 · SANITY</dt>
                <dd data-i18n="experience.statStep3Desc">Sandbox & Human Gate</dd>
              </div>
            </div>

            <ul class="ticks" style="margin-bottom: 0;">
              {proHighlights.map((item, idx) => (
                <li data-i18n-html={`experience.proHighlights.${idx}`}>
                  <strong>{item.company}:</strong> {item.detail}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
